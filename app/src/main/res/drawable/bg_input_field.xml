<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorInputBackground" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/colorFocusStroke" />
            <corners android:radius="@dimen/input_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorInputBackground" />
            <stroke android:width="1dp" android:color="@color/colorDivider" />
            <corners android:radius="@dimen/input_corner_radius" />
        </shape>
    </item>
</selector>
