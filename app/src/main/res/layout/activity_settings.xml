<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:descendantFocusability="blocksDescendants"
        android:padding="@dimen/padding_medium">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            android:paddingBottom="@dimen/padding_medium" />

        <!-- Default Language Pair -->
        <LinearLayout
            android:id="@+id/settingLanguagePair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focusable"
            android:orientation="horizontal"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="4dp"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_default_language"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_size_medium" />
            <TextView
                android:id="@+id/tvSettingLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- Instant Translate -->
        <LinearLayout
            android:id="@+id/settingInstantTranslate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focusable"
            android:orientation="horizontal"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="4dp"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_instant_translate"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_size_medium" />
            <TextView
                android:id="@+id/tvSettingInstant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- TTS Enabled -->
        <LinearLayout
            android:id="@+id/settingTts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focusable"
            android:orientation="horizontal"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="4dp"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_tts_enabled"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_size_medium" />
            <TextView
                android:id="@+id/tvSettingTts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- TTS Speed -->
        <LinearLayout
            android:id="@+id/settingTtsSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focusable"
            android:orientation="horizontal"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="4dp"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_tts_speed"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_size_medium" />
            <TextView
                android:id="@+id/tvSettingTtsSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- Font Size -->
        <LinearLayout
            android:id="@+id/settingFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focusable"
            android:orientation="horizontal"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="4dp"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_font_size"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_size_medium" />
            <TextView
                android:id="@+id/tvSettingFontSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- History Enabled -->
        <LinearLayout
            android:id="@+id/settingHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focusable"
            android:orientation="horizontal"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="4dp"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_history_enabled"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_size_medium" />
            <TextView
                android:id="@+id/tvSettingHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- Clear History -->
        <TextView
            android:id="@+id/settingClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focusable"
            android:padding="@dimen/padding_medium"
            android:text="@string/settings_clear_history"
            android:textColor="@color/colorError"
            android:textSize="@dimen/text_size_medium"
            android:layout_marginBottom="4dp"
            android:focusable="true" />

        <!-- App Version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/padding_medium">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_app_version"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_size_medium" />
            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80E0E0E0"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
